# এই ফাইলটা .env.local নামে কপি করো এবং আসল ভ্যালু বসাও (git এ commit হয় না)

# MySQL database connection (Hostinger hPanel > Databases > MySQL Databases থেকে পাবে)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# Admin session JWT সাইনিং সিক্রেট — production এ অবশ্যই একটা লম্বা random string দাও
ADMIN_SESSION_SECRET=একটা-লম্বা-random-string-বসাও-production-এ
